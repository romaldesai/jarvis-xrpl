# XRP2India - copy to .env (gitignored) and fill locally. Placeholders only. TESTNET ONLY.
# Never paste real values into this file.

# ---------- Settlement rail ----------
# evm  = AP4M flow on XRPL EVM Sidechain testnet (default)
# xrpl = fallback: native XRPL Testnet payment via xrpl.js
# mock = in-process simulated chain (offline demo / CI)
SETTLEMENT_RAIL=evm

# ---------- XRPL EVM Sidechain TESTNET (verified, see README "Verified facts") ----------
EVM_RPC_URL=https://rpc.testnet.xrplevm.org
EVM_CHAIN_ID=1449000
EVM_EXPLORER_URL=https://explorer.testnet.xrplevm.org

# Agent signer key (signs EIP-712 vouchers + sends redeem/settle txs). Generate with: npm run wallet:new
AGENT_PRIVATE_KEY=YOUR_AGENT_PRIVATE_KEY_HERE
# Funding wallet registered with Mastercard AP4M (public address is fine to share).
FUNDER_ADDRESS=0xcBcc8c442d312D2D2b4B3d124d268fC235294e2C
# Only Romal holds this. Needed to openChannel() from the registered funder.
FUNDER_PRIVATE_KEY=YOUR_FUNDER_PRIVATE_KEY_HERE
# Payout (merchant / off-ramp partner) address that receives settled RLUSD.
PAYOUT_ADDRESS=YOUR_PAYOUT_EVM_ADDRESS_HERE

# ---------- AP4M contracts ----------
# Leave blank to use our spec-compatible contracts from contracts/deployments/xrplevmTestnet.json.
# When Mastercard publishes official addresses, paste them here (config swap, no code change).
AP4M_REGISTRY_ADDRESS=
AP4M_LEDGER_ADDRESS=
RLUSD_ADDRESS=
AP4M_CHANNEL_ID=

# ---------- Policy (integer base units) ----------
# RLUSD has 18 decimals; caps are in whole-cent USD to keep humans sane, converted in code.
POLICY_PER_TX_CAP_USD_CENTS=10000
POLICY_DAILY_CAP_USD_CENTS=25000
# Comma-separated allow-listed recipients: alias:upiId
POLICY_ALLOWED_RECIPIENTS=mother:mom.demo@okaxis,brother:bro.demo@okhdfcbank
# Channel cap (RLUSD whole units) locked at openChannel
CHANNEL_CAP_RLUSD=500

# ---------- Kill switch ----------
# Set to 1, or create the file at KILL_SWITCH_FILE, to make the signer refuse everything.
KILL_SWITCH=0
KILL_SWITCH_FILE=./killswitch.flag

# ---------- FX quote ----------
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_STATIC_USD_INR=88.00
FEE_USD_CENTS=99

# ---------- Audit ----------
AUDIT_LOG_PATH=./audit.jsonl

# ---------- LLM intent parser (optional; regex fallback is always available) ----------
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
# Optional. If unset (or no API key), the deterministic regex parser is used.
ANTHROPIC_MODEL=YOUR_ANTHROPIC_MODEL_ID_HERE

# ---------- Fallback: native XRPL Testnet ----------
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_EXPLORER_URL=https://testnet.xrpl.org
XRPL_SENDER_SEED=YOUR_TESTNET_SENDER_SEED_HERE
XRPL_PAYOUT_ADDRESS=YOUR_TESTNET_PAYOUT_ADDRESS_HERE
