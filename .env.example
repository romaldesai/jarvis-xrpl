# Copy this file to .env (which is gitignored) and fill it in locally.
# Placeholders only: never commit real values. Testnet only.

# --- XRPL network (testnet) ---
XRPL_NETWORK=testnet
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233

# --- Wallets: generated and funded from the testnet faucet during the build window ---
# Seeds live only in your local .env. Addresses are public and safe to share.
XRPL_AGENT_SEED=YOUR_TESTNET_AGENT_SEED_HERE
XRPL_HUMAN_SEED=YOUR_TESTNET_HUMAN_SEED_HERE
XRPL_MERCHANT_ADDRESS=YOUR_TESTNET_MERCHANT_ADDRESS_HERE

# --- Policy limits (drops of XRP, whole numbers) ---
POLICY_PER_TX_CAP_DROPS=YOUR_PER_TRANSACTION_CAP_HERE
POLICY_DAILY_CAP_DROPS=YOUR_DAILY_CAP_HERE
POLICY_ALLOWED_DESTINATIONS=YOUR_COMMA_SEPARATED_TESTNET_ADDRESSES_HERE
ESCROW_CANCEL_AFTER_SECONDS=YOUR_CANCEL_AFTER_SECONDS_HERE

# --- Audit log ---
AUDIT_LOG_PATH=./audit.jsonl

# --- The language model that proposes payment intents (it never sees the seeds) ---
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
